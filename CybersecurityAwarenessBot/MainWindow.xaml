<Window x:Class="CybersecurityAwarenessBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant"
        Width="1200" Height="780"
        MinWidth="1000" MinHeight="650"
        Background="#F4F7FB"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17324D" CornerRadius="14" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CYBERSECURITY AWARENESS ASSISTANT"
                               Foreground="White" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="Learn • Practise • Stay Safe Online"
                               Foreground="#D8E6F2" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔊 Play Greeting" Click="PlayGreeting_Click"
                        Background="#2F80ED" Foreground="White"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="💬 Chatbot">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <TextBlock x:Name="AsciiArtText"
                                       FontFamily="Consolas" FontSize="14"
                                       Foreground="#17324D"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <RichTextBox Grid.Row="1" x:Name="ChatHistory"
                                     IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                     Background="White" BorderThickness="0" Padding="12"/>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInput" Height="48"
                                     VerticalContentAlignment="Center"
                                     KeyDown="ChatInput_KeyDown"
                                     ToolTip="Try: tell me about phishing, add a task, start quiz, show activity log"/>
                            <Button Grid.Column="1" Content="Send" Click="Send_Click"
                                    Background="#17324D" Foreground="White" Width="95" Height="48"/>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Quick Actions" FontSize="19" FontWeight="Bold"
                                       Foreground="#17324D" Margin="0,0,0,8"/>
                            <Button Content="Password Safety" Click="QuickPassword_Click"/>
                            <Button Content="Phishing Tips" Click="QuickPhishing_Click"/>
                            <Button Content="Safe Browsing" Click="QuickBrowsing_Click"/>
                            <Button Content="Privacy" Click="QuickPrivacy_Click"/>
                            <Button Content="Start Quiz" Click="StartQuiz_Click"/>
                            <Button Content="Open Tasks" Click="OpenTasks_Click"/>
                            <Button Content="Show Activity Log" Click="ShowLog_Click"/>
                            <Separator Margin="4,12"/>
                            <TextBlock Text="Memory" FontWeight="Bold" Foreground="#17324D"/>
                            <TextBlock x:Name="MemorySummary" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            <TextBlock Text="Your name:" FontWeight="SemiBold"/>
                            <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>
                            <TextBlock Text="Favourite cybersecurity topic:" FontWeight="SemiBold"/>
                            <ComboBox x:Name="TopicBox" SelectionChanged="TopicBox_SelectionChanged">
                                <ComboBoxItem Content="Password Safety"/>
                                <ComboBoxItem Content="Phishing"/>
                                <ComboBoxItem Content="Privacy"/>
                                <ComboBoxItem Content="Safe Browsing"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="✅ Task Assistant">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TaskTitleBox" Grid.Column="0" ToolTip="Task title"
                                     Text="Enable two-factor authentication"/>
                            <TextBox x:Name="TaskDescriptionBox" Grid.Column="1"
                                     ToolTip="Task description"
                                     Text="Improve the security of an important account."/>
                            <DatePicker x:Name="ReminderDatePicker" Grid.Column="2"
                                        SelectedDateFormat="Short"/>
                            <Button Grid.Column="3" Content="Add Task" Click="AddTask_Click"
                                    Background="#17324D" Foreground="White"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="TasksGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" Background="White" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.3*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Reminder" Binding="{Binding ReminderDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTemplateColumn Header="Actions" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Complete" Click="CompleteTask_Click"/>
                                            <Button Content="Delete" Click="DeleteTask_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🎯 Cyber Quiz">
                <Grid Margin="30">
                    <Border Background="White" CornerRadius="12" Padding="28" MaxWidth="850"
                            HorizontalAlignment="Center" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Cybersecurity Knowledge Quiz"
                                       FontSize="26" FontWeight="Bold" Foreground="#17324D"/>
                            <TextBlock x:Name="QuizProgress" FontSize="14" Margin="0,5,0,18"/>
                            <TextBlock x:Name="QuizQuestion" TextWrapping="Wrap"
                                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <StackPanel x:Name="QuizOptions"/>
                            <TextBlock x:Name="QuizFeedback" TextWrapping="Wrap"
                                       FontSize="15" Margin="0,15,0,10"/>
                            <Button x:Name="NextQuizButton" Content="Start Quiz"
                                    Click="NextQuizButton_Click"
                                    Background="#17324D" Foreground="White"
                                    Width="160" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="QuizFinalScore" FontSize="18"
                                       FontWeight="Bold" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="📋 Activity Log">
                <Grid Margin="12">
                    <Border Background="White" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Recent Activity" FontSize="22" FontWeight="Bold"
                                           Foreground="#17324D"/>
                                <Button DockPanel.Dock="Right"
        Content="Refresh"
        Click="RefreshLog_Click"/>
                            </DockPanel>
                            <TextBlock Text="The application keeps the most recent actions concise and easy to review."
                                       Margin="0,5,0,12"/>
                            <ListBox x:Name="ActivityList" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="StatusText"
                   Foreground="#526777" Margin="5,10,0,0"/>
    </Grid>
</Window>
